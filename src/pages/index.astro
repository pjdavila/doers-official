---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
---

<Layout title="DOERS - Premier AI Development Agency Puerto Rico">
	<main>
    <nav class="fixed top-0 w-full z-50 p-6 flex justify-between items-center backdrop-blur-sm">
      <img src="/images/DOERS-Horizontal.png" alt="DOERS" class="h-10 md:h-12" loading="eager" />
      <div class="hidden md:flex gap-8 font-space text-sm">
        <a href="#services" class="text-white hover:text-orange transition-colors">Services</a>
        <a href="#work" class="text-white hover:text-orange transition-colors">Work</a>
        <a href="#about" class="text-white hover:text-orange transition-colors">About</a>
        <a href="#contact" class="text-white bg-white/10 px-6 py-2 rounded-full hover:bg-white/20 transition-all border border-white/10">Get Started</a>
      </div>
    </nav>
		<Hero />
    <Services />
    <Work />
    
    <section id="contact" class="py-20 bg-black text-center border-t border-white/5">
      <div class="container mx-auto px-6">
        <h2 class="font-bebas text-4xl md:text-6xl text-white mb-6">READY TO <span class="text-orange">LAUNCH</span>?</h2>
        <p class="text-gray font-space mb-8 max-w-xl mx-auto italic">Everything is now in Native Astro. Performance optimization complete.</p>
        <a href="mailto:info@doers.dev" class="bg-orange text-white px-10 py-5 rounded-full font-space font-bold text-xl hover:shadow-[0_0_50px_rgba(255,90,31,0.5)] transition-all inline-block">LET'S BUILD SOMETHING AMAZING</a>
      </div>
    </section>

    <footer class="py-12 bg-black border-t border-white/5 text-center">
       <p class="text-gray/50 text-sm font-space">© 2026 DOERS. Native Astro Implementation.</p>
    </footer>
	</main>
</Layout>
