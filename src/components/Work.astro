---
interface Project {
  image: string;
  category: string;
  title: string;
  description: string;
  categoryColor: string;
  categories: string[];
}

const projects: Project[] = [
  {
    image: "/images/projects/WAPA_TV_OTT_Streaming_8cf1a965.png",
    category: "OTT App",
    title: "WAPA TV",
    description: "OTT platform for the #1 TV station in PR.",
    categoryColor: "text-orange",
    categories: ["apps"],
  },
  {
    image: "/images/projects/TeleOnce_Website_Redesign_2772bc46.png",
    category: "Web Design",
    title: "TeleOnce",
    description: "Responsive web redesign and news portal.",
    categoryColor: "text-purple",
    categories: ["apps", "websites"],
  },
  {
    image: "/images/projects/PRTicket_E-commerce_Platform_9f37733b.png",
    category: "E-commerce",
    title: "PRTicket",
    description: "Custom ticketing system for major events.",
    categoryColor: "text-orange",
    categories: ["websites"],
  },
  {
    image: "/images/projects/Jeep_RAM_Interactive_Experience_3ad3eead.png",
    category: "Interactive",
    title: "Jeep & RAM",
    description: "Interactive car configurator and dealer platform.",
    categoryColor: "text-purple",
    categories: ["websites"],
  }
];
---
<section id="work" class="py-20 relative overflow-hidden bg-black">
  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <h2 class="font-bebas text-4xl md:text-6xl mb-4 text-white">Our Work</h2>
      <p class="font-space text-lg text-gray max-w-2xl mx-auto">Explore our portfolio of digital solutions</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      {projects.map((project) => (
        <div class="rounded-2xl overflow-hidden relative group">
          <div class="relative w-full h-0 pb-[56.25%] overflow-hidden bg-gray/10">
            <img 
              src={project.image} 
              alt={project.title} 
              class="absolute top-0 left-0 w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="absolute bottom-0 left-0 p-8 w-full translate-y-2 group-hover:translate-y-0 transition-transform">
            <span class={`${project.categoryColor} font-space text-xs uppercase tracking-widest mb-2 block`}>{project.category}</span>
            <h3 class="font-space text-2xl mb-2 text-white">{project.title}</h3>
            <p class="text-gray/80 text-sm mb-4 max-w-md opacity-0 group-hover:opacity-100 transition-opacity">{project.description}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a href="/work" class="inline-flex items-center gap-2 border border-white/20 px-8 py-4 rounded-full font-space font-medium text-lg text-white hover:bg-white/5 transition-all">
        <span>View All Projects</span>
      </a>
    </div>
  </div>
</section>
